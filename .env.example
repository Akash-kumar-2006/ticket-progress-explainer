# ------------------------------------------------------------------
# Ticket Progress Explanation Generator - environment example
# Copy to `.env` and adjust. NEVER commit `.env`.
# ------------------------------------------------------------------

# Database URL. SQLite for local development.
# PostgreSQL (production-like) example:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ticket_progress
DATABASE_URL=sqlite:///./ticket_progress.db

# Comma separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# System versions (also stored on every generated explanation)
RULES_VERSION=1.0.0
MODEL_VERSION=1.0.0

# "As-of" date used by the date-risk engine for the synthetic dataset.
# The synthetic dataset is generated against this reference date so that
# demo tickets remain stable (e.g. DEMO-003 stays AT_RISK).
REFERENCE_DATE=2026-09-07

# Opt-in, optional. The application runs fully without these.
# If LLM_PROVIDER is left empty the rule-based generator is used.
# LLM_PROVIDER=
# LLM_API_KEY=

# Optional external ticketing integration (stub is used when disabled)
# TICKETING_INTEGRATION=stub